{
  "name": "dinus-code",
  "version": "0.1.0",
  "description": "Dinus Code - local AI coding agent powered by Ollama",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dinus": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "execa": "^9.5.2",
    "fuse.js": "^7.0.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.1.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tree-sitter": "^0.22.4",
    "tree-sitter-javascript": "^0.23.1",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
